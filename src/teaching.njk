{#
  Teaching — dc.html L403–420 이식.
  원본은 과목명이 "[ 과목명 ]" placeholder 였다. 실제 강의는 Teaching 탭에서 채운다.
  term/description 은 아직 비어 있어 있는 것만 렌더한다 (빈 줄을 만들지 않는다).
#}
<div class="page">
  <span class="eyebrow">Teaching</span>
  <h1 class="h-page">Teaching</h1>

  <div class="cardgrid course-grid">
    {% for c in cms.Teaching %}
    <div class="course">
      <span class="course__level">{{ c.level | upper }}</span>
      <span class="course__name">{{ c.title_en }}</span>
      {% if c.title_ko %}<span class="course__code">{{ c.title_ko }}</span>{% endif %}
      <span class="course__code">{{ c.course_code }}{% if c.term %} · {{ c.term }}{% endif %}</span>
      {# 개요가 있을 때만 구분선과 본문을 낸다. 없는데 내면 카드 아래에
         선 하나와 빈 자리만 남아 미완성으로 보인다. #}
      {% if c.description %}
      <span class="rule"></span>
      <span class="course__desc">{{ c.description }}</span>
      {% endif %}
    </div>
    {% endfor %}
  </div>
</div>
