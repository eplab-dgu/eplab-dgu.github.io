---
layout: base.njk
title: Researchers
permalink: /team/researchers/
---
{# Team > Researchers — dc.html L212–258 이식. Members 탭을 category 로 나눈다. #}
{% set grads = cms.Members | where("category", "Graduate") %}
{% set undergrads = cms.Members | where("category", "Undergraduate") %}
{#
  졸업생은 두 갈래다 (2026-09-02):
    isDegreeAlumni=true  → 석사·박사 학위 취득자. 재학생과 같은 사진 카드.
    false                → 학부연구생. 사진 없이 텍스트 줄로만.
  판정은 cms-schema.js 의 derive 가 position 을 보고 한다.
#}
{% set alumni = cms.Members | where("category", "Alumni") %}
{% set degreeAlumni = alumni | where("isDegreeAlumni", true) %}
{% set ugAlumni = alumni | where("isDegreeAlumni", false) %}

<div class="page">
  <span class="eyebrow">Team</span>
  <h1 class="h-page">Researchers</h1>

  <div class="team-block">
    {% if grads.length %}
    <div>
      <div class="cv__label">GRADUATE STUDENTS</div>
      <div class="cardgrid team-grid-grad">
        {% for p in grads %}
        <div class="person">
          <div class="imgslot imgslot-sm person__photo{% if p.photo_url %} has-img{% endif %}">
            {% if p.photo_url %}<img src="{{ p.photo_url }}" alt="{{ p.name_en }}" loading="lazy">
            {% else %}[ PHOTO ]{% endif %}
          </div>
          <div class="person__lines">
            <span class="person__ko">{{ p.name_ko or p.name_en }}</span>
            <span class="person__en">{{ p.name_en }}</span>
            <span class="person__role">{{ p.position }}</span>
            <span class="person__email">{{ p.email }}</span>
          </div>
        </div>
        {% endfor %}
      </div>
    </div>
    {% endif %}

    {% if undergrads.length %}
    <div>
      <div class="cv__label">UNDERGRADUATE STUDENTS</div>
      {# 대학원생과 같은 그리드·같은 카드 크기를 쓴다 (2026-09-02) #}
      <div class="cardgrid team-grid-grad">
        {% for p in undergrads %}
        <div class="person">
          <div class="imgslot imgslot-sm person__photo{% if p.photo_url %} has-img{% endif %}">
            {% if p.photo_url %}<img src="{{ p.photo_url }}" alt="{{ p.name_en }}" loading="lazy">
            {% else %}[ PHOTO ]{% endif %}
          </div>
          <div class="person__lines">
            <span class="person__ko">{{ p.name_ko or p.name_en }}</span>
            <span class="person__en">{{ p.name_en }}</span>
            <span class="person__role">{{ p.position }}</span>
          </div>
        </div>
        {% endfor %}
      </div>
    </div>
    {% endif %}

    {% if degreeAlumni.length %}
    <div>
      <div class="cv__label">ALUMNI</div>
      <div class="cardgrid team-grid-grad">
        {% for p in degreeAlumni %}
        <div class="person">
          <div class="imgslot imgslot-sm person__photo{% if p.photo_url %} has-img{% endif %}">
            {% if p.photo_url %}<img src="{{ p.photo_url }}" alt="{{ p.name_en }}" loading="lazy">
            {% else %}[ PHOTO ]{% endif %}
          </div>
          {#
            졸업생 카드는 세 줄이다 (2026-09-02 확정):
              김찬우 (석사, 2026.08)
              Chan-Woo Kim
              현대자동차 연구개발본부      ← 주황색 볼드
            학위·취득년월을 이름 줄에 괄호로 붙이므로 재학생 카드와 줄 구성이 다르다.
          #}
          <div class="person__lines">
            <span class="person__ko">
              {{- p.name_ko or p.name_en -}}
              {%- if p.position or p.degreeDate %} ({{ p.position }}{% if p.position and p.degreeDate %}, {% endif %}{{ p.degreeDate }}){% endif -%}
            </span>
            <span class="person__en">{{ p.name_en }}</span>
            <span class="person__affil">{{ p.current_affiliation }}</span>
          </div>
        </div>
        {% endfor %}
      </div>
    </div>
    {% endif %}

    {# 학부연구생 졸업생 — 위 ALUMNI 카드 아래로 이어지므로 별도 라벨을 두지 않는다 #}
    {% if ugAlumni.length %}
    <div>
      <div class="datalist">
        {% for p in ugAlumni %}
        <div class="alumni__row">
          <span>{{ p.name_ko or p.name_en }} <span class="dim">{{ p.name_en }}</span></span>
          <span class="alumni__role">{{ p.position }}{% if p.cohort_period %} ({{ p.cohort_period }}){% endif %}</span>
          <span class="alumni__next">{{ p.current_affiliation }}</span>
        </div>
        {% endfor %}
      </div>
    </div>
    {% endif %}
  </div>
</div>
