{#
  공용 레이아웃 — dc.html 의 <header>(L24–46) · <footer>(L511–530) 이식.
  원본의 인라인 스타일은 src/assets/css/site.css 의 클래스로 옮겼고,
  드롭다운 hover 는 support.js 이벤트 대신 CSS :hover 로 처리한다.
#}<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{% if title %}{{ title }} · {% endif %}{{ cms.config.site_short or "eP Lab." }}</title>
<meta name="description" content="{{ description or cms.config.site_name }} — {{ cms.config.university }}">
{# 파비콘은 정사각 SVG 래퍼 — 원본 로고(84×93)를 그대로 쓰면 탭에서 찌그러진다 #}
<link rel="icon" href="/assets/favicon.svg">
<link rel="apple-touch-icon" href="/assets/logo.png">
<link rel="stylesheet" href="/assets/css/site.css">
</head>
<body>
<div class="shell">

<header class="site-header">
  <div class="site-header__inner">
    <a class="brand" href="/">
      <span class="brand__mark"><img src="/assets/logo.png" alt="" width="33" height="36"></span>
      <span class="brand__text">
        <span class="brand__name"><em>electrified</em> Propulsion Lab.</span>
        {# 디자인 L28: 헤더 브랜드는 영문 대문자 #}
        <span class="brand__org">{{ cms.configEn.university | upper }}</span>
      </span>
    </a>

    <nav class="nav">
      {% for item in nav %}
        {%- set isActive = (page.url == "/") if item.exact else page.url.startsWith(item.match) -%}
        <div class="nav__item{% if isActive %} is-active{% endif %}">
          <a class="nav__link" href="{{ item.href }}">{{ item.label }}</a>
          {% if item.children.length %}
          <div class="nav__panel">
            {% for c in item.children %}
            <a class="nav__sub{% if page.url == c.href %} is-current{% endif %}" href="{{ c.href }}">{{ c.label }}</a>
            {% endfor %}
          </div>
          {% endif %}
        </div>
      {% endfor %}
    </nav>
  </div>
</header>

<main>
{{ content | safe }}
</main>

<footer class="site-footer">
  <div class="site-footer__inner">
    <div class="site-footer__col">
      <div class="site-footer__brand">
        <span class="brand__mark"><img src="/assets/logo.png" alt="" width="29" height="32"></span>
        <span><em style="color:var(--accent);font-style:normal">electrified</em> Propulsion Lab.</span>
      </div>
      <span class="site-footer__addr">{{ cms.config.dept }}<br>{{ cms.config.address }}</span>
    </div>

    <div class="site-footer__contact">
      <span class="site-footer__label">CONTACT</span>
      <a href="mailto:{{ cms.config.email }}">{{ cms.config.email }}</a>
      <span>{{ cms.config.tel }}</span>
      {% if cms.config.scholar_url %}<a href="{{ cms.config.scholar_url }}">Google Scholar</a>{% endif %}
    </div>

    <div class="site-footer__legal">
      <span>{{ cms.config.footer }}</span>
    </div>
  </div>
</footer>

</div>
{% if hasScript %}<script src="/assets/js/site.js" defer></script>{% endif %}
</body>
</html>
