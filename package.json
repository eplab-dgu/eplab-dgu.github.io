{
  "name": "eplab-website",
  "version": "0.1.0",
  "private": true,
  "description": "eP Lab (Dongguk Univ.) website — static site built from a Google Sheet CMS",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dump": "node scripts/xlsx-to-json.js",
    "build": "eleventy",
    "serve": "eleventy --serve",
    "clean": "node -e \"fs.rmSync('_site',{recursive:true,force:true})\"",
    "cache:refresh": "node scripts/sheets-to-cache.js",
    "hero": "node scripts/hero-illustration.js",
    "report": "node scripts/content-report.js"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.1.6"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "googleapis": "^176.0.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  }
}
