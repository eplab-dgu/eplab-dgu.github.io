# Google Sheets CMS 접근 정보. 둘 다 없으면 data-cache/ 목업으로 빌드된다.
#
# SHEET_ID: 시트 URL의 /d/ 와 /edit 사이 문자열
SHEET_ID=

# GOOGLE_SERVICE_ACCOUNT_JSON: 서비스 계정 키 JSON **전체**를 한 줄로 넣는다.
#   - 시트를 해당 서비스 계정 이메일에 "뷰어"로 공유해야 읽힌다.
#   - 이 파일(.env)은 절대 커밋하지 않는다. CI 에서는 GitHub Secrets 로 주입.
GOOGLE_SERVICE_ACCOUNT_JSON=
