# Google Sheets CMS 접근 정보.
#
# 이 값이 둘 다 있으면 빌드가 **Google Sheet 에서** 콘텐츠를 읽는다.
# 없으면 로컬 eplab_website_content.xlsx 로 빌드한다 (오프라인 개발).
# API 가 실패하면 data-cache/ 폴백으로 내려가고, 빌드는 어느 경우에도 성공한다.
#
# CMS_SOURCE=xlsx 를 주면 키가 있어도 시트를 건너뛴다.
#
# SHEET_ID: 시트 URL의 /d/ 와 /edit 사이 문자열
SHEET_ID=

# GOOGLE_SERVICE_ACCOUNT_JSON: 서비스 계정 키 JSON **전체**를 한 줄로 넣는다.
#   - 시트를 해당 서비스 계정 이메일에 "뷰어"로 공유해야 읽힌다.
#   - 이 파일(.env)은 절대 커밋하지 않는다. CI 에서는 GitHub Secrets 로 주입.
GOOGLE_SERVICE_ACCOUNT_JSON=
